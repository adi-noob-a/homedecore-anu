# ─── Supabase (PostgreSQL Database) ───
# Create a free project at https://supabase.com
# Copy these values from your project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Notes ───
# - NEXT_PUBLIC_ prefixed vars are exposed to the browser (safe for anon key)
# - Never store service_role keys in client code
# - Create a .env.local file locally (this .env.example is for reference)
# - On Vercel: paste both vars in Project Settings > Environment Variables
