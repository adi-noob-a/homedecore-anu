{
  "module": "calculator",
  "version": "1.0.0",
  "description": "Budget Allocation Calculator data \u2014 property archetypes, room defaults, finish multipliers, and budget splits",
  "propertyArchetypes": [
    {
      "type": "rental",
      "label": "Rental Investment",
      "budgetPercentage": {
        "min": 7,
        "max": 8
      },
      "formula": "propertyValue * 0.07 to propertyValue * 0.08",
      "description": "Designed for tenant appeal and durability at minimal cost.",
      "defaultRooms": [
        {
          "room": "Living Room",
          "units": [
            "TV Unit"
          ],
          "quantity": 1,
          "required": true,
          "media": {
            "icon": "/images/calculator/icon-room-living-room.svg"
          }
        },
        {
          "room": "Bedroom",
          "units": [
            "Wardrobe (Swing)"
          ],
          "quantity": 2,
          "required": true,
          "maxQuantity": 5,
          "media": {
            "icon": "/images/calculator/icon-room-bedroom.svg"
          }
        },
        {
          "room": "Kitchen",
          "units": [
            "Base Cabinets",
            "Wall Units (no tall unit)"
          ],
          "quantity": 1,
          "required": true,
          "finishDefault": "laminate",
          "media": {
            "icon": "/images/calculator/icon-room-kitchen.svg"
          }
        },
        {
          "room": "Shoe Unit",
          "units": [
            "Shoe Cabinet"
          ],
          "quantity": 1,
          "required": false,
          "media": {
            "icon": "/images/calculator/icon-room-shoe-unit.svg"
          }
        }
      ],
      "finishDefaults": {
        "kitchen": "laminate",
        "wardrobe": "laminate",
        "countertop": "granite"
      },
      "hardwareDefault": "indian",
      "media": {
        "card_image": "/images/calculator/archetype-rental.jpg",
        "card_video": null,
        "icon": "/images/calculator/icon-rental.svg",
        "diagram": "/images/calculator/rental-floorplan.svg"
      },
      "animation": {
        "enter": {
          "type": "slideUp",
          "delay": 100,
          "duration": 400,
          "trigger": "onViewport"
        },
        "hover": {
          "effect": "lift",
          "target": "card",
          "feedback": "scale up"
        }
      }
    },
    {
      "type": "personal",
      "label": "Personal Home",
      "budgetPercentage": {
        "min": 10,
        "max": 10
      },
      "formula": "propertyValue * 0.10",
      "description": "Designed for long-term family living with better finishes and full storage.",
      "defaultRooms": [
        {
          "room": "Living Room",
          "units": [
            "TV Unit"
          ],
          "quantity": 1,
          "required": true,
          "media": {
